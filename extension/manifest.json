{
  "manifest_version": 3,
  "name": "Ditto · Browser Bridge",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Full-profile periodic Cookie sync, active new-tab sync, and open-tab Storage sync for the paired remote Ditto browser.",
  "permissions": ["cookies", "history", "storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ditto 登录态同步",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http: https: ws: wss:" }
}
