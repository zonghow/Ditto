{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ditto-browser": {
        "type": "local",
        "command": [
          "node", "node_modules/@playwright/mcp/cli.js",
          "--cdp-endpoint", "http://127.0.0.1:9222",
          "--no-webmcp", "--output-dir", "artifacts/mcp"
        ]
      }
    }
  }
}
