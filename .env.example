# Infrastructure / container overrides (highest precedence over config.json).
# User-facing settings (token, viewport, userAgent, demo, etc.) belong in
# $DITTO_DATA_DIR/config.json (see config.example.json).
#
# DITTO_DATA_DIR=/absolute/path/to/private/ditto-data
# DITTO_CONFIG=/absolute/path/to/config.json
# DITTO_LOG_DIR=./logs
# DITTO_LOG_FILE=/logs/ditto.log
# DITTO_HOST=0.0.0.0
# DITTO_PORT=3217
# DITTO_CDP_PORT=9222
# DITTO_CHROMIUM_PATH=/usr/bin/chromium
# DITTO_TOKEN=
# DITTO_AUTH=
# DITTO_DEMO=0
